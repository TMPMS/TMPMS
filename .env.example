# ===== FRONTEND (Vercel) =====
# URL của backend trên Render.com (điền sau khi deploy backend)
VITE_API_URL=https://tmpms-backend.onrender.com

# ===== BACKEND (Render.com) =====
# Connection string PostgreSQL từ Neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/tmpms?sslmode=require

# URL của frontend (để CORS)
FRONTEND_URL=https://tmpms.vercel.app

# Port (Render tự set, không cần thay đổi)
PORT=3000

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
