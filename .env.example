# API backend. Local dev: point at your local TMPMS_BE (include /api since the backend
# maps controllers under /api/*). Production build: leave empty — the real prod value is
# injected by .github/workflows/frontend.yml from the VITE_API_URL repo secret at Docker
# build time, and is the same origin as the frontend (e.g. https://tmpms.io.vn/api).
VITE_API_URL=http://localhost:5000/api

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID). Not a secret —
# public client identifier.
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Firebase project config (Firebase Console -> Project settings). Not secrets either —
# web API keys are meant to be public, access is restricted via Firebase Security Rules.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx
